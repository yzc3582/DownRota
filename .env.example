# ===== QQ 机器人配置 =====
# 你的AppID
APP_ID=
# 你的AppSecret
APP_SECRET=
# 你的群openid（非必须）
GROUP_OPENID=

# ===== RotaBOT 配置 =====
# RotaBOT的openid
# 如果为空，程序会在终端打印收到的所有群消息，方便你抓取
ROTABOT_OPENID=

# ===== 图片保存路径配置 =====
# B40 图片固定保存路径（OBS 直接读取这个）
SAVE_PATH_B40=b40_latest.png

# 其它指令图片的保存前缀（程序会自动加上时间戳，如 img_1730824321.png）
SAVE_PATH_OTHER=img_other_